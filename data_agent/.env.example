# Configurazione locale Data Agent: non pubblicare mai il file .env reale.
TRIALPULSE_PANDAS_ENABLED=0
# Necessaria solo per la generazione dinamica; nessun segreto nell'esecutore.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Facoltativo: percorso assoluto della stessa coda privata dell'esecutore.
# Senza questa variabile il percorso è data_agent/.pandas_queue.
# TRIALPULSE_PANDAS_QUEUE=
